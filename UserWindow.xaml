<Window x:Class="ErrorChecker.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistance à distance" Width="420" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#F0F0F0" Closing="Window_Closing" Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <!-- Avant la demande -->
        <StackPanel x:Name="IdlePanel">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#2C3E50"
                       Text="Un problème avec l'application ? Décrivez-le en une phrase (facultatif), puis cliquez sur le bouton. Le support recevra un mail et ne verra votre écran qu'après votre accord."/>
            <DockPanel x:Name="HelperPanel" Margin="0,0,0,8">
                <TextBlock Text="Envoyer à :" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#2C3E50"/>
                <ComboBox x:Name="HelperBox"/>
            </DockPanel>
            <TextBox x:Name="ProblemText" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            <Button x:Name="HelpButton" Content="Demander de l'aide" Height="40" FontSize="16" Margin="0,10,0,0" Click="HelpButton_Click"/>
            <Expander x:Name="HelperExpander" Header="Je suis le dépanneur" Margin="0,14,0,0" Foreground="#7F8C8D">
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="Rejoindre" Margin="6,0,0,0" Click="JoinButton_Click" IsDefault="{Binding IsKeyboardFocusWithin, ElementName=CodeText}"/>
                    <TextBox x:Name="CodeText" ToolTip="Code reçu par mail, ex. K7QM-2XPA-9TRD (ou le lien errorchecker:...)"/>
                </DockPanel>
            </Expander>
        </StackPanel>

        <!-- Demande envoyée, puis assistance en cours -->
        <StackPanel x:Name="SessionPanel" Visibility="Collapsed">
            <TextBlock x:Name="SessionStatus" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,10" Foreground="#2C3E50"/>
            <Button x:Name="StopButton" Height="34" Click="StopButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
